# Public URL used in canonical, Open Graph and X/Twitter metadata.
# Define the same value in your Lovable deployment settings when the final domain is available.
VITE_SITE_URL=https://seu-dominio.com.br

# Server-only secrets. Configure these in the production host/Lovable secrets
# area; do not prefix them with VITE_ and never commit their actual values.
ASAAS_WEBHOOK_TOKEN=
# Keep disabled until the persistent Asaas provisioning worker is configured.
ASAAS_WEBHOOK_ENABLED=false
